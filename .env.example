# Copie ce fichier en .env puis remplis les valeurs.
# Ne commite jamais le fichier .env.

# URL publique de l'application (sans slash final). Sert aussi à vérifier l'en-tête Origin.
APP_ORIGIN=http://localhost:5173

# Base de données
POSTGRES_USER=forever
POSTGRES_PASSWORD=change-me-with-a-long-random-value
POSTGRES_DB=forever
DATABASE_URL=postgres://forever:change-me-with-a-long-random-value@localhost:5432/forever

# Cookies : true derrière HTTPS (production). false seulement pour le développement en http.
COOKIE_SECURE=false

# E-mails (Mailpit en développement : interface sur http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Forever Roster <no-reply@forever-roster.local>"

# Vérifier les mots de passe contre la base Have I Been Pwned (k-anonymity, seul un préfixe de hash est envoyé)
HIBP_CHECK=true

# Battle.net OAuth : https://develop.battle.net/access/clients
# Redirect URL à déclarer chez Blizzard : ${APP_ORIGIN}/api/auth/battlenet/callback
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_OAUTH_HOST=https://oauth.battle.net

# Nom de domaine pour Caddy en production (certificat HTTPS automatique)
DOMAIN=localhost
