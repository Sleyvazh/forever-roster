{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roster Companion",
  "mainBinaryName": "roster-companion",
  "version": "0.2.1",
  "identifier": "fr.sleyvazh.rostercompanion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sleyvazh",
    "copyright": "© 2026 Sleyvazh, licence MIT",
    "category": "Utility",
    "shortDescription": "Synchro entre l'addon Forever Roster et le site",
    "longDescription": "Roster Companion envoie tes persos et tes bilans de raid au site Forever Roster, et dépose les données de tes groupes pour l'addon, sans copier-coller.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
