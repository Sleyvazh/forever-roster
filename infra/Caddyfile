{
	# Certificats HTTPS automatiques (Let's Encrypt) quand DOMAIN est un vrai nom de domaine.
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	# Pas de compression pour le flux en direct (/api/events) : elle retiendrait les événements.
	@compress not path /api/events
	encode @compress zstd gzip

	# En-têtes de sécurité pour tout le site
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Doublon de frame-ancestors 'none' (CSP) pour les anciens navigateurs et les outils d'audit
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		-Server
	}

	# API : Caddy transmet l'IP réelle du client (X-Forwarded-For), l'API a TRUST_PROXY=true.
	# Événements en direct (Server-Sent Events) : transmis au fil de l'eau, connexion longue.
	handle /api/events {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# Icônes du jeu (dossier icons/ du serveur, hors dépôt Git). Pas de repli sur index.html :
	# une icône absente répond 404 et le front affiche l'initiale de la classe.
	handle_path /icons/* {
		root * /srv/icons
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Addon à télécharger : toujours la dernière version (revalidé), proposé en fichier, jamais de repli sur index.html
	handle /downloads/* {
		root * /srv
		header Cache-Control "no-cache"
		header Content-Disposition "attachment"
		file_server
	}

	# Front React (SPA) : fichiers statiques, repli sur index.html pour les routes du client.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
